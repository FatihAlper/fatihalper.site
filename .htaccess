Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Protect Kirby internals, content files and local maintenance tooling.
  RewriteRule ^(content|site|kirby|tools)/(.*)$ - [F,L]
  RewriteRule ^\.git/(.*)$ - [F,L]
  RewriteRule ^\.env.*$ - [F,L]
  RewriteRule ^(composer\.(json|lock)|README\.md|server.*\.log)$ - [F,L]

  # Let real files and directories pass through, including assets and media.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Route everything else through Kirby, including /panel and detail pages.
  RewriteRule ^(.*)$ index.php [L]
</IfModule>
